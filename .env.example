# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bedrock supervisor (set USE_BEDROCK_SUPERVISOR=true to replace rule-based supervisor)
USE_BEDROCK_SUPERVISOR=false
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Data source: "local" reads from ./data, "s3" reads from S3_BUCKET/S3_DATA_PREFIX
DATA_SOURCE=local
S3_BUCKET=
S3_DATA_PREFIX=data
