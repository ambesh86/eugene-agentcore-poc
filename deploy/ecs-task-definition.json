{
  "family": "eugene-agentcore-poc",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/eugeneAgentCoreTaskRole",
  "containerDefinitions": [
    {
      "name": "eugene-agentcore-poc",
      "image": "<ACCOUNT_ID>.dkr.ecr.<AWS_REGION>.amazonaws.com/eugene-agentcore-poc:latest",
      "portMappings": [
        {
          "containerPort": 8501,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        { "name": "AWS_REGION", "value": "<AWS_REGION>" },
        { "name": "USE_BEDROCK_SUPERVISOR", "value": "true" },
        { "name": "BEDROCK_MODEL_ID", "value": "us.anthropic.claude-haiku-4-5-20251001-v1:0" },
        { "name": "DATA_SOURCE", "value": "s3" },
        { "name": "S3_BUCKET", "value": "<S3_BUCKET_NAME>" },
        { "name": "S3_DATA_PREFIX", "value": "data" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/eugene-agentcore-poc",
          "awslogs-region": "<AWS_REGION>",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:8501/_stcore/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 20
      }
    }
  ]
}
